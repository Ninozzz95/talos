{
  "name": "talos-harness-ui-frontend",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:lab": "node scripts/build-lab.mjs",
    "test:unit": "node scripts/run-node-tests.mjs",
    "test:workflow-review": "node node_modules/@playwright/test/cli.js test -c playwright.workflow-review.config.mjs",
    "test": "npm run test:unit && npm run test:componenti",
    "verify": "node scripts/verify.mjs",
    "package": "node scripts/package-frontend.mjs",
    "test:componenti": "node scripts/run-browser-tests.mjs --config=playwright.componenti.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@floating-ui/dom": "1.8.0",
    "@tanstack/virtual-core": "3.17.8",
    "@xyflow/system": "0.0.83",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.16",
    "elkjs": "0.12.0",
    "pdfjs-dist": "6.3.289",
    "pptx-viewer-core": "4.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
