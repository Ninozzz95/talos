{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talos.local/contracts/runtime-event-v1.schema.json",
  "title": "TALOS Harness Desktop runtime resource",
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "items", "consulted", "observedAt", "reason"],
      "properties": {
        "schema": { "const": "talos.harness-ui.resource.v1" },
        "status": { "enum": ["available", "unavailable"] },
        "items": { "type": ["array", "null"] },
        "consulted": { "type": "boolean" },
        "observedAt": { "type": "string", "format": "date-time" },
        "reason": { "type": ["string", "null"] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "items", "consulted", "observedAt", "reason"],
  "properties": {
    "schema": { "const": "talos.harness-ui.resource.v1" },
    "status": { "enum": ["available", "unavailable"] },
    "items": { "type": ["array", "null"] },
    "consulted": { "type": "boolean" },
    "observedAt": { "type": "string", "format": "date-time" },
    "reason": { "type": ["string", "null"] }
  }
}
