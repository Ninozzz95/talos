{
  "name": "talos-desktop",
  "version": "0.1.23",
  "private": true,
  "description": "Il guscio desktop di TALOS, con il runtime Node incluso in Electron.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:puri && npm run test:guscio",
    "test:puri": "node --test tests/*.test.mjs",
    "test:guscio": "node --test --test-concurrency=1 tests/backend.spec.mjs tests/guscio.spec.mjs",
    "icone": "node scripts/genera-icone.mjs",
    "prova:pty": "node scripts/prova-pty.mjs",
    "prepara": "node scripts/prepara-pacchetto.mjs && node scripts/verifica-protezioni-kernel.mjs",
    "dist": "npm run prepara && node scripts/distribuisci.mjs",
    "test:installer": "node --test --test-concurrency=1 tests/installer.spec.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.3.0",
    "electron-builder": "26.16.1",
    "resedit": "1.7.2"
  },
  "build": {
    "appId": "it.talos.desktop",
    "productName": "TALOS",
    "electronVersion": "44.3.0",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asar": false,
    "npmRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Ninozzz95/talos/releases"
      }
    ],
    "toolsets": {
      "nsis": "1.2.1"
    },
    "artifactName": "TALOS-Setup-${version}.${ext}",
    "files": [
      "main.mjs",
      "profile.mjs",
      "migrazione-browser.mjs",
      "runtime.mjs",
      "child-bootstrap.mjs",
      "lifecycle.mjs",
      "log.mjs",
      "window-state.mjs",
      "barra-finestra.mjs",
      "firma-aggiornamenti.mjs",
      "aggiornamenti.mjs",
      "canale-aggiornamenti.mjs",
      "fonte-aggiornamenti.mjs",
      "package.json",
      "assets/talos.png",
      "assets/talos-tray.png",
      "assets/aggiornamenti-pubblica.pem"
    ],
    "extraResources": [
      {
        "from": ".staging/harness-ui",
        "to": "harness-ui"
      },
      {
        "from": ".staging/harness-ui/node_modules",
        "to": "harness-ui/node_modules"
      },
      {
        "from": ".staging/context-engine",
        "to": "context-engine"
      },
      {
        "from": ".staging/context-engine/node_modules",
        "to": "context-engine/node_modules"
      },
      {
        "from": ".staging/local-runtime",
        "to": "local-runtime"
      },
      {
        "from": ".staging/casa-linux",
        "to": "casa-linux"
      },
      {
        "from": ".staging/docs",
        "to": "docs"
      },
      {
        "from": ".staging/MANIFEST.json",
        "to": "MANIFEST.json"
      },
      {
        "from": ".staging/AVVISI.txt",
        "to": "AVVISI.txt"
      },
      {
        "from": ".staging/LICENZA-REPOSITORY.txt",
        "to": "LICENZA-REPOSITORY.txt"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/talos.ico",
      "signExecutable": false,
      "artifactName": "TALOS-${version}-win.${ext}"
    },
    "nsis": {
      "artifactName": "TALOS-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/talos.ico",
      "uninstallerIcon": "assets/talos.ico",
      "installerHeaderIcon": "assets/talos.ico",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp",
      "license": "assets/licenza-installer.txt",
      "installerLanguages": [
        "it_IT"
      ],
      "language": "1040",
      "include": "assets/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "shortcutName": "TALOS",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "packElevateHelper": false,
      "differentialPackage": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
