{
  "name": "talos-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Il guscio desktop di TALOS, con il runtime Node incluso in Electron.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:puri && npm run test:guscio",
    "test:puri": "node --test tests/*.test.mjs",
    "test:guscio": "node --test --test-concurrency=1 tests/backend.spec.mjs tests/guscio.spec.mjs",
    "icone": "node scripts/genera-icone.mjs",
    "prova:pty": "node scripts/prova-pty.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.3.0"
  }
}
