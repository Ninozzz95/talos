{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talos.local/evolution/schemas/extension-manifest.schema.json",
  "title": "TALOS Evolution Extension Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "extensionId",
    "version",
    "artifactHash",
    "witWorld",
    "tools",
    "actions",
    "requestedCapabilities",
    "uiContributionHash",
    "stateContract",
    "compatibility"
  ],
  "properties": {
    "schema": {
      "const": "talos.evolution.extension-manifest.v1"
    },
    "extensionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "artifactHash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "witWorld": {
      "const": "talos:extension/extension@0.1.0"
    },
    "tools": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "inputSchema": {
            "type": "object"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "requestedCapabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/capability"
      }
    },
    "uiContributionHash": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "stateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "maxBytes"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      }
    },
    "compatibility": {
      "$ref": "common.schema.json#/$defs/protocolCompatibility"
    }
  }
}
