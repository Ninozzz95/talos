<?xml version="1.0" encoding="utf-8"?>
<!--
    E0 — la dichiarazione che rende il servizio un candidato al ruolo assistente.

    `supportsAssist` e' la riga che conta: senza, il sistema non consegna mai la
    AssistStructure e la prova risponderebbe «no» per un motivo nostro invece che
    per un motivo di ColorOS.
-->
<voice-interaction-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="ai.talos.agent.TalosAssistProbeSessionService"
    android:recognitionService="ai.talos.agent.TalosAssistProbeRecognition"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
