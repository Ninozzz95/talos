<?xml version="1.0" encoding="utf-8"?>
<!--
    ⭐ La dichiarazione che rende TALOS un candidato al ruolo di assistente.

    `supportsAssist` è la riga che conta: senza, il sistema non consegna mai la
    struttura dello schermo — e il 2026-08-11 è stata proprio quella riga a
    permettere la misura che ha chiuso E0 con un sì (49 nodi su Impostazioni,
    212 sull'elenco app, e lo screenshot).

    ⛔ `supportsLaunchVoiceAssistFromKeyguard="false"`: TALOS non si apre a
    telefono bloccato. Un assistente che parte sopra la schermata di blocco è
    un assistente che chiunque abbia il telefono in mano può interrogare.
-->
<voice-interaction-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="ai.talos.agent.TalosAssistenteSessioneService"
    android:recognitionService="ai.talos.agent.TalosAssistenteRiconoscimento"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
