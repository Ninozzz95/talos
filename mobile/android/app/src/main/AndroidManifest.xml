<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- F5.1 #29 root cause (Android 11+ package visibility): without this
         declaration SpeechRecognizer cannot bind the RecognitionService and
         dictation dies silently. https://developer.android.com/about/versions/11/behavior-changes-11 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>


    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- The launcher entry lives on the per-theme activity-alias list below
                 (owner 2026-07-24: launcher icon follows the active theme). MainActivity
                 itself carries no LAUNCHER category so exactly one alias is ever the
                 launcher, avoiding duplicate home-screen icons. -->
        </activity>

        <!-- GENERATED alias list (tools/android-assets/gen_theme_icons.py). Exactly one
             alias is android:enabled="true" at any time; the default-theme alias ships
             enabled so the app is always launchable even if the feature is never used.
             The active alias is switched natively (TalosAppIconPlugin) on app pause. -->
        <activity-alias
            android:name=".MainActivityIcon_forge"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_forge"
            android:roundIcon="@mipmap/ic_launcher_forge_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityIcon_paper"
