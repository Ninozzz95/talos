{
  "_why": [
    "One table of cases, two runners. The download loop must run natively — the",
    "WebView is suspended in the background, which is the entire reason the job",
    "exists — so the policy has to exist in Java. It also exists in TypeScript,",
    "for the interface and for tests that need no device.",
    "",
    "Two implementations of one rule diverge. It has happened three times in this",
    "codebase already, and the copy that diverges is never the one you are looking",
    "at. So neither implementation owns the rules: this file does, and both test",
    "suites execute it. A difference between them fails a test instead of waiting",
    "on a phone to be discovered.",
    "",
    "Byte values are written out in full rather than as expressions, because Java",
    "and TypeScript must read exactly the same numbers.",
    "",
    "`storageReserveBytes` is here for the same reason and was very nearly the",
    "fourth divergence: the fit gate in fit.ts kept 1 GiB free, the native",
    "transfer plan kept 256 MiB, and a user with 700 MiB of slack would have been",
    "told the model does not fit by one half and had it downloaded by the other.",
    "There is only ever one answer to 'will it fit', so there is only one number."
  ],
  "constants": {
    "storageReserveBytes": 1073741824,
    "windowBytes": 134217728,
    "checkpointMs": 5000,
    "checkpointBytes": 8388608,
    "stallMs": 8000,
    "resolveMarginMs": 300000,
    "maxFailures": 8
  },
  "steps": [
    {
      "name": "nothing resolved yet",
      "state": { "totalBytes": 4294967296, "haveBytes": 0, "url": null, "urlDeadlineMs": null, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "nowMs": 1000000,
      "expect": { "kind": "resolve" }
    },
    {
      "name": "signature about to expire — resolve BEFORE it fails",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 1120000, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "nowMs": 1000000,
      "expect": { "kind": "resolve" }
    },
    {
      "name": "healthy — ask for a full window from where the bytes end",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "nowMs": 1000000,
      "expect": { "kind": "request", "rangeFrom": 1073741824, "rangeTo": 1207959551 }
    },
    {
      "name": "near the end — the range is inclusive and stops at the last byte",
      "state": { "totalBytes": 1000, "haveBytes": 0, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "nowMs": 1000000,
      "expect": { "kind": "request", "rangeFrom": 0, "rangeTo": 999 }
    },
    {
      "name": "every byte present — verify, never fetch more",
      "state": { "totalBytes": 1000, "haveBytes": 1000, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "nowMs": 1000000,
      "expect": { "kind": "verify" }
    },
    {
      "name": "checkpoint on TIME with almost nothing received — the commuter-train livelock",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1005000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 12288 },
      "nowMs": 1005001,
      "expect": { "kind": "checkpoint" }
    },
    {
      "name": "checkpoint on bytes when they arrive faster than the clock",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1000100, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 8388609 },
      "nowMs": 1000100,
      "expect": { "kind": "checkpoint" }
    },
    {
      "name": "a socket that hangs is named, not spun over",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "nowMs": 1008001,
      "expect": { "kind": "stall" }
    }
  ],
  "outcomes": [
    {
      "name": "403 is the signature expiring — re-resolve and keep every byte",
      "state": { "totalBytes": 4294967296, "haveBytes": 3221225472, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "outcome": { "kind": "status", "status": 403 },
      "nowMs": 1000000,
      "expectStep": { "kind": "resolve" },
      "expectState": { "haveBytes": 3221225472, "consecutiveFailures": 1, "url": null }
    },
    {
      "name": "a 403 that never stops is not a signature expiring — it stops",
      "_why": "The count used to be RESET here, so a gated repo or a revoked token produced an unbounded request loop at full speed with no sleep and no way out. Arriving BYTES clear the count; a status that merely looks recoverable does not.",
      "state": { "totalBytes": 4294967296, "haveBytes": 3221225472, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 7, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "outcome": { "kind": "status", "status": 403 },
      "nowMs": 1000000,
      "expectStep": { "kind": "give-up", "reason": "forbidden" },
      "expectState": { "consecutiveFailures": 8 }
    },
    {
      "name": "429 counts, so the wait actually grows",
      "_why": "The backoff was computed from a count that never moved: two seconds forever, a client doubling its own rate against the limiter it was meant to respect, never reaching MAX_FAILURES.",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 2, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "outcome": { "kind": "status", "status": 429 },
      "nowMs": 1000000,
      "expectStep": { "kind": "wait", "seconds": 8, "reason": "rate-limited" },
      "expectState": { "consecutiveFailures": 3 }
    },
    {
      "name": "and a rate limit that never lifts stops rather than hammering forever",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 7, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "outcome": { "kind": "status", "status": 429 },
      "nowMs": 1000000,
      "expectStep": { "kind": "give-up", "reason": "rate-limited" }
    },
    {
      "name": "416 means the file changed upstream — never resume into it",
      "state": { "totalBytes": 4294967296, "haveBytes": 3221225472, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "outcome": { "kind": "status", "status": 416 },
      "nowMs": 1000000,
      "expectStep": { "kind": "give-up", "reason": "file-changed" },
      "expectState": { "haveBytes": 0 }
    },
    {
      "name": "429 waits exactly as long as the Hub said",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "outcome": { "kind": "status", "status": 429, "retryAfterSeconds": 254 },
      "nowMs": 1000000,
      "expectStep": { "kind": "wait", "seconds": 254, "reason": "rate-limited" },
      "expectState": { "haveBytes": 1073741824 }
    },
    {
      "name": "a transport failure backs off and keeps what is on disk",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 0, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "outcome": { "kind": "error" },
      "nowMs": 1000000,
      "expectStep": { "kind": "wait", "seconds": 2, "reason": "backoff" },
      "expectState": { "haveBytes": 1073741824, "consecutiveFailures": 1 }
    },
    {
      "name": "enough consecutive failures and it stops, with a reason",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 7, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "outcome": { "kind": "error" },
      "nowMs": 1000000,
      "expectStep": { "kind": "give-up", "reason": "unreachable" },
      "expectState": { "consecutiveFailures": 8 }
    },
    {
      "name": "arriving bytes are the only proof the link works, so they clear the failures",
      "state": { "totalBytes": 4294967296, "haveBytes": 1073741824, "url": "https://cdn/x", "urlDeadlineMs": 4600000, "consecutiveFailures": 3, "lastProgressAtMs": 1000000, "lastCheckpointAtMs": 1000000, "bytesSinceCheckpoint": 0 },
      "outcome": { "kind": "bytes", "count": 8388608 },
      "nowMs": 1000000,
      "expectState": { "haveBytes": 1082130432, "consecutiveFailures": 0, "bytesSinceCheckpoint": 8388608 }
    }
  ]
}
