{
    "name": "talos-mobile",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/contracts",
        "packages/design-tokens"
    ],
    "engines": {
        "node": ">=24.18.0 <25",
        "npm": ">=11.16.0 <12"
    },
    "packageManager": "npm@11.16.0",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.18.0 <25",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=11.16.0 <12",
            "onFail": "error"
        }
    },
    "scripts": {
        "preinstall": "node scripts/assert-runtime.mjs",
        "dev": "vite",
        "build": "vue-tsc -b && vite build && node scripts/verify-initial-chunk.mjs",
        "preview": "vite preview",
        "test:unit": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@aparajita/capacitor-biometric-auth": "10.0.0",
        "@aparajita/capacitor-secure-storage": "8.0.0",
        "@capacitor-community/speech-recognition": "7.0.1",
        "@capacitor-community/sqlite": "8.1.0",
        "@capacitor/android": "8.4.2",
        "@capacitor/app": "8.1.1",
        "@capacitor/clipboard": "8.0.1",
        "@capacitor/core": "8.4.2",
        "@capacitor/filesystem": "8.1.2",
        "@capacitor/haptics": "8.0.2",
        "@capacitor/inappbrowser": "4.0.1",
        "@capacitor/keyboard": "8.0.5",
        "@capacitor/preferences": "8.0.1",
        "@capacitor/share": "8.0.1",
        "@capacitor/status-bar": "8.0.3",
        "@capawesome/capacitor-file-picker": "8.0.3",
        "@fontsource/instrument-sans": "5.2.8",
        "@fontsource/jetbrains-mono": "5.2.8",
        "@fontsource/orbitron": "5.3.0",
        "@lucide/vue": "1.25.0",
        "@talos-mobile/contracts": "file:packages/contracts",
        "@talos-mobile/design-tokens": "file:packages/design-tokens",
        "@vueuse/core": "14.3.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "dompurify": "3.4.12",
        "file-type": "22.0.1",
        "jeep-sqlite": "2.8.0",
        "js-sha256": "0.11.1",
        "mammoth": "1.12.0",
        "markdown-it": "14.3.0",
        "pdfjs-dist": "6.1.200",
        "reka-ui": "2.10.1",
        "sql.js": "1.11.0",
        "tailwind-merge": "3.6.0",
        "tw-animate-css": "1.4.0",
        "vaul-vue": "0.4.1",
        "vue": "3.5.40",
        "vue-router": "5.2.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@capacitor/cli": "8.4.2",
        "@playwright/test": "1.61.1",
        "@tailwindcss/vite": "4.3.3",
        "@types/markdown-it": "14.1.2",
        "@types/node": "24.13.3",
        "@vitejs/plugin-vue": "6.0.8",
        "@vue/test-utils": "2.4.11",
        "@vue/tsconfig": "0.9.1",
        "jsdom": "29.1.1",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "vite": "7.3.6",
        "vitest": "4.1.10",
        "vue-tsc": "3.3.7"
    }
}
