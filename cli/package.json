{
  "name": "talos-code",
  "version": "0.7.0",
  "description": "TALOS in the terminal: a coding agent with per-tool permissions, file checkpoints and resumable sessions, on the model you choose.",
  "keywords": [
    "coding-agent",
    "cli",
    "terminal",
    "llm",
    "ai",
    "agent"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ninozzz95/talos.git",
    "directory": "cli"
  },
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "bin": {
    "talos": "dist/main.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && node scripts/bundle.mjs && node scripts/pack-vendor.mjs && node scripts/pack-documents.mjs && node scripts/bundle-kernel.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs \"test/**/*.test.ts\"",
    "test:local": "node scripts/run-tests.mjs \"test/**/*.test.ts\"",
    "test:tui": "node scripts/run-tests.mjs \"test/tui/**/*.test.ts\"",
    "test:acceptance": "npm run build && node scripts/run-tests.mjs --test-concurrency=1 --test-timeout=300000 \"test/acceptance/**/*.scenario.ts\"",
    "prepack": "node scripts/clean-dist.mjs && npm run build",
    "test:kernel": "node scripts/kernel-tests.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@vscode/ripgrep": "1.18.0",
    "iconv-lite": "0.7.3",
    "node-notifier": "10.0.1",
    "sqlite-vec": "0.1.9",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/google": "4.0.64",
    "@ai-sdk/openai": "4.0.61",
    "@microsoft/mxc-sdk": "0.8.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.4",
    "@types/react": "19.2.17",
    "@xterm/headless": "6.0.0",
    "ai": "7.0.93",
    "canonicalize": "5.1.0",
    "croner": "10.0.1",
    "diff": "9.0.0",
    "docx": "9.5.1",
    "eld": "2.1.0",
    "esbuild": "0.28.2",
    "eventsource-parser": "4.1.0",
    "ink": "7.1.1",
    "jszip": "3.10.1",
    "markdown-it": "14.3.0",
    "node-pty": "1.2.0-beta.15",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pdfmake": "0.3.11",
    "pptxgenjs": "4.0.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "string-width": "8.2.2",
    "unicode-segmenter": "0.15.0",
    "web-push": "3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.5.4"
  },
  "files": [
    "dist/",
    "kernel/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
