# produce. Lo script (scripts/qa-visual-pipeline.mjs) resta versionato.
harness-ui/.qa-runs/

# Desktop UI build output; source and manifest generator live in harness-ui/public/ and scripts/.
harness-ui/dist/

# ⛔⛔⛔ 30/8, FASE L — trovato mentre aggiungevo .sessions-store/ qui
# sotto: .mcp-trust/ (FASE E) e .plugin-trust/ (FASE G) non erano MAI
# state aggiunte, un debito dormiente (mai popolate finora, quindi mai
# rischiato un commit reale — verificato, non presunto) corretto qui
# nello stesso giro, stesso principio di .hooks-trust/ sopra.
harness-ui/.mcp-trust/
harness-ui/.plugin-trust/

# ⭐ 30/8 — FASE L: il registro persistito delle sessioni (una riga
# JSONL per evento, append-only) — dati locali generati a runtime,
# stesso principio di .automations/ in cima a questo blocco.
harness-ui/.sessions-store/

# ⭐ 30/8 — FASE N, quarto sistema: le note dell'owner, GLOBALI (non
# per-progetto, vedi la doc in notes-store.mjs) — dati locali generati
# a runtime, stesso principio di .automations/ in cima a questo blocco.
harness-ui/.notes-store/

# ⭐ 30/8 — FASE N, quinto sistema: le attività dell'owner, GLOBALI —
# stesso principio esatto di .notes-store/ appena sopra.
harness-ui/.tasks-store/

# ⭐ 30/8 — FASE N, sesto sistema: le memorie dell'owner, GLOBALI —
# stesso principio esatto di .notes-store/.tasks-store/ appena sopra.
harness-ui/.memory-store/

# ⭐ 30/8 — FASE N, nono e ultimo sistema: i tool forgiati dal modello,
# GLOBALI — stesso principio esatto di .notes-store/ eccetera sopra.
harness-ui/.tool-forge-store/

# Official llama.cpp runtime binary, downloaded and verified locally from the
