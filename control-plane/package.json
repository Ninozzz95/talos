{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "patch:dependencies": "patch-package --error-on-fail",
        "postinstall": "npm run patch:dependencies",
        "prebuild": "npm run patch:dependencies",
        "build": "node scripts/vite-build.mjs",
        "predev": "npm run patch:dependencies",
        "dev": "vite",
        "test:browser-gates-config": "node --test scripts/browser-gates-config.test.mjs",
        "test:browser-action-keypair": "node --test scripts/browser-action-keypair.test.mjs",
        "test:dev-stack": "node --test scripts/dev-stack.test.mjs",
        "test:playwright-server-config": "node --test scripts/playwright-server-config.test.mjs",
        "test:human-journey:types": "tsc --project tsconfig.human-journey.json",
        "test:human-journey:unit": "npm run test:human-journey:types && playwright test --config=playwright.human-journey.config.ts --project=contracts --workers=1",
        "test:human-journey": "npm run test:human-journey:types && playwright test --config=playwright.human-journey.config.ts --workers=1",
        "test:unit": "vitest run",
        "test:window-chunks": "npm run build && node --test scripts/window-chunk-contract.test.mjs",
        "test:e2e:visible-ui": "npm run build && playwright test --workers=1 --grep \"painted-frame\"",
        "test:e2e:dictation-driver": "npm run build && playwright test --config=playwright.dictation.config.ts --workers=1",
        "test:e2e:cross-browser-smoke": "npm run build && playwright test --config=playwright.cross-browser.config.ts",
        "test:e2e": "npm run build && node --test scripts/window-chunk-contract.test.mjs && playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "26.1.1",
        "@types/pngjs": "^6.0.5",
        "concurrently": "^9.0.1",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^3.1",
        "patch-package": "8.0.1",
        "pngjs": "^7.0.0",
        "pure-rand": "8.4.2",
        "shadcn-vue": "2.7.4",
        "tailwindcss": "^4.0.0",
        "typescript": "5.9.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.10",
        "yaml": "2.9.0",
        "zod": "4.4.3"
    },
    "dependencies": {
        "@fontsource/instrument-sans": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@fontsource/manrope": "^5.2.8",
        "@fontsource/opendyslexic": "5.2.5",
        "@fontsource/orbitron": "^5.2.8",
        "@fontsource/sora": "^5.2.8",
        "@fontsource/source-serif-4": "^5.2.9",
        "@huggingface/transformers": "^4.2.0",
        "@lucide/vue": "^1.24.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.11",
        "eventsource-parser": "3.1.0",
        "idb": "8.0.3",
        "interactjs": "1.10.27",
        "markdown-it": "^14.3.0",
        "reka-ui": "2.10.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "1.4.0",
        "vue": "^3.5.39",
        "vue-sonner": "2.0.9"
    }
}
