{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/clear-vite-hot.mjs && vite build",
        "dev": "vite",
        "test:dev-stack": "node --test scripts/dev-stack.test.mjs",
        "test:unit": "vitest run",
        "test:window-chunks": "npm run build && node --test scripts/window-chunk-contract.test.mjs",
        "test:e2e:visible-ui": "npm run build && playwright test --workers=1 --grep \"painted-frame\"",
        "test:e2e:cross-browser-smoke": "npm run build && playwright test --config=playwright.cross-browser.config.ts",
        "test:e2e": "npm run build && node --test scripts/window-chunk-contract.test.mjs && playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/markdown-it": "^14.1.2",
        "@types/pngjs": "^6.0.5",
        "concurrently": "^9.0.1",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^3.1",
        "pngjs": "^7.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@fontsource/instrument-sans": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@fontsource/manrope": "^5.2.8",
        "@fontsource/orbitron": "^5.2.8",
        "@fontsource/sora": "^5.2.8",
        "@fontsource/source-serif-4": "^5.2.9",
        "@lucide/vue": "^1.23.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.11",
        "markdown-it": "^14.3.0",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.6.0",
        "vue": "^3.5.39"
    }
}
