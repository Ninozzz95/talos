{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": false,
        "checkJs": false,
        "strict": true,
        "noEmit": true,
        "types": ["node"],
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "playwright.human-journey.config.ts",
        "tests/human-journey/**/*.ts"
    ]
}
