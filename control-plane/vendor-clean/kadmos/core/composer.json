{
    "name": "kadmos/core",
    "description": "AVM Pure PHP Engine",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "mcp/sdk": "0.6.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Kadmos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kadmos\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "php kadmos test"
    },
    "authors": [
        {
            "name": "antoninorizzo",
            "email": "ninozz142@gmail.com"
        }
    ]
}
