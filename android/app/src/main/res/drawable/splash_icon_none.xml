<?xml version="1.0" encoding="utf-8"?>
<!-- Owner 2026-07-24: a transparent splash icon. The per-theme static splash frame
     cannot be dynamic at cold start (Android shows it before app code runs — by
     design), so we make it logo-less: the DayNight windowSplashScreenBackground
     matches the default (system) theme and the themed in-app boot animation reads
     as starting directly. Android 12+ falls back to the launcher icon when no
     animated icon is set, hence this explicit transparent drawable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
