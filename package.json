{
  "name": "talos-mobile",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/design-tokens"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.18.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0 <12",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/assert-runtime.mjs",
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/verify-initial-chunk.mjs && npm run verify:parity && npm run sync:harness-ui-mobile && npm run verify:android:codice-in-release",
    "sync:harness-ui-mobile": "node scripts/sync-harness-ui-mobile.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:local-models:device": "node scripts/run-local-model-compatibility.mjs",
    "verify:android:permission-metadata": "node scripts/verify-release-permission-metadata.mjs",
    "verify:android:backend-artifact": "node scripts/verify-local-backend-artifact.mjs",
    "verify:android:codice-in-release": "node scripts/verify-codice-ships-in-release.mjs",
    "verify:android:plugin-classes": "node scripts/verify-release-plugin-classes.mjs",
    "test:scripts": "node --test scripts/verify-parity-ledger.test.mjs scripts/verify-local-backend-artifact.test.mjs scripts/sync-harness-ui-mobile.test.mjs scripts/verify-codice-ships-in-release.test.mjs scripts/verify-release-plugin-classes.test.mjs",
    "verify:parity": "npm run test:scripts && node scripts/verify-parity-ledger.mjs docs/feature-parity.json",
    "typecheck": "vue-tsc -b --force",
    "harness:kernel": "vite build --config scripts/harness-talos/vite.banco.config.mjs",
    "build:probe": "vite build --config vite.probe.config.ts && node -e \"require('node:fs').readdirSync('dist/probe/assets').filter(f=>f.endsWith('.wasm')).forEach(f=>require('node:fs').rmSync(`dist/probe/assets/${f}`))\""
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.1",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/inappbrowser": "4.0.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome/capacitor-file-picker": "8.0.3",
    "@capgo/capacitor-speech-recognition": "8.1.7",
    "@fontsource/instrument-sans": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@lucide/vue": "1.25.0",
    "@mozilla/readability": "0.6.0",
    "@talos-mobile/contracts": "file:packages/contracts",
    "@talos-mobile/design-tokens": "file:packages/design-tokens",
    "@vueuse/core": "14.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "9.5.1",
    "dompurify": "3.4.12",
    "file-type": "22.0.1",
    "hash-wasm": "4.12.0",
    "jeep-sqlite": "2.8.0",
    "js-sha256": "0.11.1",
    "jszip": "3.10.1",
    "mammoth": "1.12.0",
    "markdown-it": "14.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "pdfmake": "0.3.11",
    "pptxgenjs": "4.0.1",
    "reka-ui": "2.10.1",
    "sql.js": "1.11.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unicode-segmenter": "0.15.0",
    "vaul-vue": "0.4.1",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "xlsx": "file:upstream/sheetjs/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@huggingface/transformers": "4.2.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  },
  "license": "Apache-2.0"
}
