#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Kadmos CLI — AVM Command Center
 * Usage: php kadmos <command> [options]
 */

$command = $argv[1] ?? '';
$args = array_slice($argv, 2);

$baseDir = __DIR__;
$autoload = __DIR__ . '/vendor/autoload.php';
if (!file_exists($autoload)) {
    fwrite(STDERR, "Run composer install in core/ first.\n");
    exit(1);
}
require_once $autoload;

function green(string $s): string { return "\033[32m{$s}\033[0m"; }
function blue(string $s): string { return "\033[34m{$s}\033[0m"; }
function yellow(string $s): string { return "\033[33m{$s}\033[0m"; }
function red(string $s): string { return "\033[31m{$s}\033[0m"; }
function bold(string $s): string { return "\033[1m{$s}\033[0m"; }

function logo(): string {
    return <<<LOGO
    ⚡ {bold}KADMOS{reset} — Agnostic Agent Virtual Machine
    "The bronze guardian of deterministic execution"

    LOGO;
}

switch ($command) {
    // ═══════════════════════════════════════════════
    case 'chat':
        // Run boot animation first
        $phpBin = $baseDir . '/../.tools/php/php.exe';
        if (!file_exists($phpBin)) $phpBin = 'php';
        $bootScript = $baseDir . '/kadmos-boot-anim.php';
        if (file_exists($bootScript)) {
            // Export env to pass to boot script which will drop to shell
            $chatScript = $baseDir . '/kadmos-chat-repl.php';
            // Just run chat directly after boot
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($bootScript));
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($chatScript));
        } else {
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($baseDir . '/kadmos-chat-repl.php'));
        }
        break;

    case 'boot':
        $phpBin = $baseDir . '/../.tools/php/php.exe';
        if (!file_exists($phpBin)) $phpBin = 'php';

        // Static mode
        if (in_array('--static', $args)) {
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($baseDir . '/kadmos-boot'));
            break;
        }

        // Animated mode (default)
        $animScript = $baseDir . '/kadmos-boot-anim.php';
        if (file_exists($animScript)) {
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($animScript));
        } else {
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($baseDir . '/kadmos-boot'));
        }
        break;

    // ═══════════════════════════════════════════════
    case 'start':
        $cycles = (int) ($args[0] ?? 10);
        $apiKey = getenv('KADMOS_API_KEY') ?: getenv('DEEPSEEK_API_KEY');
        $model = getenv('KADMOS_MODEL') ?: 'deepseek-chat';
        $baseUrl = getenv('KADMOS_BASE_URL') ?: 'https://api.deepseek.com/v1';
        $useMock = in_array('--mock', $args);

        if (!$useMock && !$apiKey) {
            echo red("Error: ") . "Set KADMOS_API_KEY or DEEPSEEK_API_KEY\n";
            echo "  cmd: set KADMOS_API_KEY=sk-...\n";
            echo "  bash: export KADMOS_API_KEY=sk-...\n";
            echo "  Or use --mock for deterministic testing\n";
            exit(1);
        }

        // Setup
        $stubWorker = new class implements \Kadmos\Workers\NodeWorkerInterface {
            public function execute(array $payload): array {
                $url = $payload['url'] ?? '?';
                return ['status' => \Kadmos\NodeStatus::SUCCESS, 'output_summary' => "200 OK ($url)", 'raw_output' => null];
            }
        };

        $registry = new \Kadmos\Workers\WorkerRegistry();
        $registry->register('HTTP_REQUEST', $stubWorker);
        $registry->register('QUERY_DATABASE', $stubWorker);

        $orchestrator = new \Kadmos\ASTOrchestrator($registry);

        if ($useMock) {
            $llm = new \Kadmos\MockLLM([
                json_encode([
                    ['action' => 'SPAWN_NODE', 'node_id' => 'n1', 'node_type' => 'HTTP_REQUEST'],
                    ['action' => 'SPAWN_NODE', 'node_id' => 'n2', 'node_type' => 'HTTP_REQUEST', 'dependencies' => ['n1']],
                ]),
                json_encode([
                    ['action' => 'MUTATE_PAYLOAD', 'node_id' => 'n1', 'payload' => ['url' => 'https://api.example.com']],
                    ['action' => 'MUTATE_PAYLOAD', 'node_id' => 'n2', 'payload' => ['url' => 'https://api.example.com']],
                    ['action' => 'YIELD_EXECUTION'],
                ]),
                json_encode([['action' => 'YIELD_EXECUTION']]),
            ]);
            $validator = new \Kadmos\Validator\MockJmpValidator(true);
        } else {
            $healthUrl = getenv('KADMOS_VALIDATOR_HEALTH_URL') ?: 'http://127.0.0.1:3000/health';
            $validatorUrl = getenv('KADMOS_VALIDATOR_URL') ?: 'http://127.0.0.1:3000/validate';
            $health = new \Kadmos\Validator\ValidatorHealthCheck($healthUrl);

            if (!$health->isHealthy()) {
                echo red("Validator unavailable. AVM ON fails closed. Start validator or use --mock.\n");
                exit(4);
            }

            $llm = new \Kadmos\OpenAIClient($apiKey, $model, $baseUrl);
            $validator = new \Kadmos\Validator\HttpJmpValidator(new \Kadmos\CurlHttpClient(), $validatorUrl);
        }

        $broadcast = 'http://127.0.0.1:3000/broadcast';
        $demoThrottle = in_array('--demo-throttle', $args);

        echo str_replace('{bold}', "\033[1m", str_replace('{reset}', "\033[0m", logo()));

        // Run boot animation (skip if --no-boot flag)
        if (!in_array('--no-boot', $args) && !$demoThrottle) {
            $bootScript = $baseDir . '/kadmos-boot';
            $phpBin = $baseDir . '/../.tools/php/php.exe';
            if (!file_exists($phpBin)) $phpBin = 'php';
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($bootScript));
        }

        echo blue("Model: ") . ($useMock ? 'MockLLM' : $model) . "\n";
        echo blue("Cycles: ") . "$cycles\n";
        echo blue("Dashboard: ") . "http://127.0.0.1:3000/dashboard\n\n";

        $controller = new \Kadmos\MainLoopController($orchestrator, $llm, $validator, $cycles, $broadcast, $demoThrottle);
        $controller->run();

        echo green("\n✓ Done — {$controller->getCycleCount()} cycles\n\n");
        echo $orchestrator->serializeDagState() . "\n";
        break;

    // ═══════════════════════════════════════════════
    case 'dashboard':
        $port = $args[0] ?? '3000';
        echo yellow("Starting dashboard on http://127.0.0.1:{$port}/dashboard ...\n");
        echo yellow("Press Ctrl+C to stop\n\n");

        $validatorDir = $baseDir . '/../validator';
        if (!is_dir($validatorDir)) {
            echo red("Error: validator directory not found\n");
            exit(1);
        }

        // Find node and tsx
        $nodeExe = $baseDir . '/../.tools/node/node.exe';
        $tsx = $baseDir . '/../.tools/node/node_modules/.bin/tsx';

        if (!file_exists($nodeExe)) {
            $nodeExe = 'node';
        }

        $cmd = sprintf(
            'cd %s && %s src/server.ts',
            escapeshellarg($validatorDir),
            file_exists($tsx) ? escapeshellarg($nodeExe) . ' ' . escapeshellarg($tsx) : 'npx tsx'
        );

        passthru("PORT={$port} {$cmd}");
        break;

    // ═══════════════════════════════════════════════
    case 'validate':
        $useMockValidator = in_array('--mock', $args, true);
        $file = null;
        foreach ($args as $arg) {
            if (!str_starts_with($arg, '--')) {
                $file = $arg;
                break;
            }
        }

        if (!$file || !file_exists($file)) {
            echo red("Usage: ") . "kadmos validate <file.json> [--mock]\n";
            exit(1);
        }

        $json = file_get_contents($file);
        $data = json_decode($json, true);

        if (!is_array($data)) {
            echo red("Error: invalid JSON\n");
            exit(1);
        }

        // Auto-detect: if it's a raw JMP array, wrap it as mutations
        if (isset($data[0]) && is_array($data[0])) {
            $mutations = $data;
        } elseif (isset($data['mutations'])) {
            $mutations = $data['mutations'];
        } else {
            $mutations = [$data];
        }

        $context = $data['context'] ?? [];

        if ($useMockValidator) {
            echo yellow("Mock validator mode: no external validator call will be made.\n");
            $validator = new \Kadmos\Validator\MockJmpValidator(true);
        } else {
            $healthUrl = getenv('KADMOS_VALIDATOR_HEALTH_URL') ?: 'http://127.0.0.1:3000/health';
            $validatorUrl = getenv('KADMOS_VALIDATOR_URL') ?: 'http://127.0.0.1:3000/validate';
            $health = new \Kadmos\Validator\ValidatorHealthCheck($healthUrl);

            if (!$health->isHealthy()) {
                echo red("Validator unavailable. AVM ON fails closed. Start validator or use --mock.\n");
                exit(4);
            }

            $validator = new \Kadmos\Validator\HttpJmpValidator(new \Kadmos\CurlHttpClient(), $validatorUrl);
        }

        $result = $validator->validate($mutations, $context);

        if ($result->valid) {
            echo green("✓ Valid JMP batch — {$file}\n");
            echo count($mutations) . " mutation(s) passed\n";
        } else {
            echo red("✗ Validation failed — {$file}\n");
            foreach ($result->errors as $fault) {
                echo red("  • {$fault->field}: ") . "{$fault->message} (expected {$fault->expected}, got {$fault->received})\n";
            }
        }
        break;

    // ═══════════════════════════════════════════════
    case 'test':
        echo bold("Kadmos Test Suite\n");
        echo "─────────────────\n\n";

        $phpBin = $baseDir . '/../.tools/php/php.exe';
        if (!file_exists($phpBin)) {
            $phpBin = 'php';
        }

        $tests = [
            'ASTOrchestrator' => "$baseDir/tests/ASTOrchestratorTest.php",
            'Worker' => "$baseDir/tests/WorkerTest.php",
            'JmpValidator' => "$baseDir/tests/JmpValidatorClientTest.php",
            'MainLoop' => "$baseDir/tests/MainLoopControllerTest.php",
            'NamespaceContract' => "$baseDir/tests/NamespaceContractTest.php",
            'AutoloadContract' => "$baseDir/tests/AutoloadContractTest.php",
            'CliBenchmarkCommand' => "$baseDir/tests/CliBenchmarkCommandTest.php",
            'BenchmarkNoDeprecation' => "$baseDir/tests/BenchmarkNoDeprecationTest.php",
            'ValidatorImplementations' => "$baseDir/tests/ValidatorImplementationsTest.php",
            'MainLoopValidatorInterface' => "$baseDir/tests/MainLoopValidatorInterfaceContractTest.php",
            'ValidatorHealthCheck' => "$baseDir/tests/ValidatorHealthCheckTest.php",
            'CliValidateFailClosed' => "$baseDir/tests/CliValidateFailClosedTest.php",
            'CliStartFailClosed' => "$baseDir/tests/CliStartFailClosedTest.php",
            'ValidatorFactory' => "$baseDir/tests/ValidatorFactoryTest.php",
            'ValidatorBypassContract' => "$baseDir/tests/ValidatorBypassContractTest.php",
            'CliTestSuiteContract' => "$baseDir/tests/CliTestSuiteContractTest.php",
        ];

        $allPassed = true;
        foreach ($tests as $name => $path) {
            echo blue("{$name}: ");
            $output = [];
            $code = 0;
            exec(escapeshellarg($phpBin) . ' ' . escapeshellarg($path) . ' 2>&1', $output, $code);
            $lastLine = end($output);

            if ($code === 0 && str_contains($lastLine, 'passed')) {
                echo green("PASSED\n");
            } else {
                echo red("FAILED\n");
                $allPassed = false;
                echo implode("\n", $output) . "\n";
            }
        }

        echo "\n";
        if ($allPassed) {
            echo green(bold("All core tests passed ✓\n"));
        } else {
            echo red(bold("Some tests failed ✗\n"));
            exit(1);
        }
        break;

    // ═══════════════════════════════════════════════
    case 'benchmark':
        $mode = $args[0] ?? 'mock';
        if (is_numeric($mode)) {
            array_unshift($args, 'mock');
            $mode = 'mock';
        }

        $phpBin = $baseDir . '/../.tools/php/php.exe';
        if (!file_exists($phpBin)) {
            $phpBin = 'php';
        }

        if ($mode === 'mock') {
            $runs = '50';
            foreach (array_slice($args, 1) as $arg) {
                if (str_starts_with($arg, '--runs=')) {
                    $runs = substr($arg, strlen('--runs='));
                } elseif (is_numeric($arg)) {
                    $runs = $arg;
                }
            }

            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($baseDir . '/kadmos-benchmark.php') . ' ' . escapeshellarg((string) $runs), $code);
            exit($code);
        }

        if ($mode === 'live') {
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($baseDir . '/kadmos-bench-live-all.php'), $code);
            exit($code);
        }

        echo red("Usage: ") . "kadmos benchmark [mock|live] [--runs=10]\n";
        exit(1);

    case 'demo':
        echo yellow("Running HMI demo...\n");
        echo yellow("Open http://127.0.0.1:3000/dashboard in your browser!\n\n");

        $demoScript = $baseDir . '/tests/hmi-demo.php';
        $phpBin = $baseDir . '/../.tools/php/php.exe';

        if (!file_exists($phpBin)) {
            $phpBin = 'php';
        }

        passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($demoScript));
        break;

    // ═══════════════════════════════════════════════
    case 'status':
        echo str_replace('{bold}', "\033[1m", str_replace('{reset}', "\033[0m", logo()));

        $phpBin = $baseDir . '/../.tools/php/php.exe';
        if (!file_exists($phpBin)) {
            $phpBin = 'php';
        }

        echo bold("Core tests: ");
        $corePass = true;
        foreach (['ASTOrchestratorTest', 'WorkerTest', 'JmpValidatorClientTest', 'MainLoopControllerTest'] as $t) {
            $out = [];
            exec(escapeshellarg($phpBin) . ' ' . escapeshellarg("$baseDir/tests/{$t}.php") . ' 2>&1', $out, $code);
            $last = end($out);
            if ($code !== 0 || !str_contains($last, 'passed')) {
                $corePass = false;
                break;
            }
        }
        echo $corePass ? green("24/24 PASSED\n") : red("FAILED\n");

        echo bold("Validator: ");
        $validatorTest = $baseDir . '/../validator';
        if (is_dir($validatorTest)) {
            echo green("installed\n");
        } else {
            echo red("not found\n");
        }

        $envKey = getenv('KADMOS_API_KEY') ?: getenv('DEEPSEEK_API_KEY');
        echo bold("API key: ") . ($envKey ? green("set") : red("not set")) . "\n";
        echo bold("Dashboard: ") . "http://127.0.0.1:3000/dashboard\n";
        break;

    // ═══════════════════════════════════════════════
    case 'help':
        echo str_replace('{bold}', "\033[1m", str_replace('{reset}', "\033[0m", logo()));
        echo bold("Commands:\n\n");
        echo "  " . green("kadmos boot") . "                      Boot animation\n";
        echo "  " . green("kadmos start [cycles] [--mock]") . "   Start the main event loop\n";
        echo "  " . green("kadmos test") . "                      Run all test suites\n";
        echo "  " . green("kadmos validate <file.json>") . "     Validate a JMP file\n";
        echo "  " . green("kadmos benchmark mock --runs=10") . " Run mock benchmark suite\n";
        echo "  " . green("kadmos status") . "                    Show system status\n";
        echo "  " . green("kadmos help") . "                      Show this help\n";
        echo "\n";
        echo bold("Environment:\n\n");
        echo "  KADMOS_API_KEY     DeepSeek/OpenAI API key\n";
        echo "  KADMOS_MODEL       Model name (default: deepseek-chat)\n";
        break;

    default:
        // No command: run boot animation + interactive shell
        $phpBin = $baseDir . '/../.tools/php/php.exe';
        if (!file_exists($phpBin)) $phpBin = 'php';
        $bootScript = $baseDir . '/kadmos-boot-anim.php';
        if (file_exists($bootScript)) {
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($bootScript));
        } else {
            passthru(escapeshellarg($phpBin) . ' ' . escapeshellarg($baseDir . '/kadmos-boot'));
        }
        break;
}
