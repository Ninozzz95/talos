{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talos.local/schema/browser/v1/browser-artifact-reference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "kind", "mime", "sha256", "byte_size", "width", "height", "redaction_status"],
  "properties": {
    "schema_version": { "const": "talos.browser.artifact.v1" },
    "artifact_id": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["snapshot", "screenshot", "download", "upload", "trace"] },
    "mime": { "type": "string", "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$", "maxLength": 255 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "byte_size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "width": { "type": ["integer", "null"], "minimum": 1, "maximum": 32768 },
    "height": { "type": ["integer", "null"], "minimum": 1, "maximum": 32768 },
    "redaction_status": { "enum": ["none", "redacted", "quarantined"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-9A-HJKMNP-TV-Z]{26})$" }
  }
}
