#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

BOOT_STATE_DIR="$ROOT_DIR/.talos"
BOOT_STATE_FILE="$ROOT_DIR/.talos/state.json"
BOOT_DISABLED=0

usage() {
  cat <<'HELP'
talos - AVM/TALOS deployment helper

Usage:
  talos up              Start the complete Docker stack from a clean checkout
  talos dev             Bootstrap native tools/dependencies and start all dev services
  talos down            Stop the Docker Compose stack
  talos logs            Follow stack logs
  talos doctor          Check Docker and native development readiness
  talos doctor --repair Repair the repo-local native toolchain and dependencies
  talos open            Open the TALOS URL in the default browser
  talos fresh           Development-only reset of Compose volumes, then start
  talos help            Show this help

Global options:
  --no-boot, --plain    Disable the first-run TALOS bootstrap animation

Environment:
  TALOS_NO_BOOT=1       Disable bootstrap output for this invocation
HELP
}

is_truthy() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

print_step() {
  printf '\n[TALOS] %s\n' "$1"
}

mark_boot_seen() {
  mkdir -p "$BOOT_STATE_DIR"
  printf '{\n  "boot_seen": true,\n  "updated_at": "%s"\n}\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" > "$BOOT_STATE_FILE"
}

should_boot() {
  local command_name="${1:-help}"

  if [ "$BOOT_DISABLED" -eq 1 ]; then
    return 1
  fi

  if is_truthy "${TALOS_NO_BOOT:-}" || is_truthy "${CI:-}"; then
    return 1
  fi

  if [ ! -t 1 ]; then
    return 1
  fi

  case "$command_name" in
    help|-h|--help) return 1 ;;
  esac

  [ ! -f "$BOOT_STATE_FILE" ]
}

boot_sequence() {
  local delay="0.08"
  if is_truthy "${TALOS_BOOT_FAST:-}"; then
    delay="0"
  fi

  printf '\033[?25l'
  printf '\n'
  printf 'TALOS bootstrap\n'
  printf '---------------\n'

  local phases=(
    "AVM graph core"
    "JMP validator"
    "Laravel control plane"
    "Queue worker"
    "Readiness probe"
  )

  local phase
  for phase in "${phases[@]}"; do
    printf '  [..] %s' "$phase"
    if [ "$delay" != "0" ]; then
      sleep "$delay"
    fi
    printf '\r  [OK] %s\n' "$phase"
  done

  printf 'Runtime profile: Docker-first TALOS workspace\n'
  printf 'Operator mode: HMI-first, fail-closed, evidence-ready\n\n'
  printf '\033[?25h'
}

maybe_boot() {
  local command_name="${1:-help}"
  if should_boot "$command_name"; then
    boot_sequence
    mark_boot_seen
  fi
}

env_value() {
  local key="$1"
  if [ ! -f .env ]; then
    return 1
  fi
  grep -E "^${key}=" .env | tail -n 1 | cut -d= -f2- || true
}

effective_env_value() {
  local key="$1"
  if [ "${!key+x}" = "x" ]; then
    printf '%s\n' "${!key}"
    return
  fi
  env_value "$key" || true
}

compose_profile_is_enabled() {
  local profile="$1"
  local profiles
  profiles="$(effective_env_value COMPOSE_PROFILES)"
  profiles="${profiles//[[:space:]]/}"

  case ",$profiles," in
    *,"$profile",*) return 0 ;;
    *) return 1 ;;
  esac
}

compose() {
  local compose_args=()
  if [ "$(effective_env_value TALOS_WEB_SEARCH_PROVIDER)" = "searxng" ] \
    && ! compose_profile_is_enabled search; then
    compose_args+=(--profile search)
  fi
  docker compose "${compose_args[@]}" "$@"
}

compose_all_profiles() {
  docker compose --profile "*" "$@"
}

reconcile_stale_search_service() {
  if [ "$(effective_env_value TALOS_WEB_SEARCH_PROVIDER)" != "searxng" ] \
    && ! compose_profile_is_enabled search; then
    echo "Reconciling stale auto-managed SearXNG service"
    docker compose --profile search rm -sf searxng
  fi
}

set_env_value() {
  local file="$1"
  local key="$2"
  local value="$3"
  if grep -qE "^${key}=" "$file"; then
    sed -i.bak "s|^${key}=.*|${key}=${value}|" "$file"
    rm -f "${file}.bak"
  else
    printf '\n%s=%s\n' "$key" "$value" >> "$file"
  fi
}

random_hex_32() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
    return
  fi
  if [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
    od -An -N32 -tx1 /dev/urandom | tr -d ' \r\n'
    return
  fi
  if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoLogo -NoProfile -Command \
      "[Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLowerInvariant()"
    return
  fi
  echo "A cryptographically secure random generator is required." >&2
  return 1
}

random_base64_32() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 32 | tr -d '\r\n'
    return
  fi
  if [ -r /dev/urandom ] && command -v dd >/dev/null 2>&1 && command -v base64 >/dev/null 2>&1; then
    dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64 | tr -d '\r\n'
    return
  fi
  if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoLogo -NoProfile -Command \
      "[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
    return
  fi
  echo "A cryptographically secure random generator is required." >&2
  return 1
}

ensure_env() {
  if [ ! -f .env ]; then
    (umask 077 && cp .env.example .env)
    echo "Created .env from .env.example"
  fi

  local browser_token
  browser_token="$(env_value TALOS_BROWSER_WORKER_TOKEN || true)"
  if [[ ! "$browser_token" =~ ^[a-f0-9]{64}$ ]]; then
    set_env_value .env TALOS_BROWSER_WORKER_TOKEN "$(random_hex_32)"
    echo "Generated the internal browser-worker credential in .env"
  fi

  local searxng_secret
  searxng_secret="$(env_value TALOS_SEARXNG_SECRET || true)"
  if [[ ! "$searxng_secret" =~ ^[a-f0-9]{64}$ ]]; then
    set_env_value .env TALOS_SEARXNG_SECRET "$(random_hex_32)"
    echo "Generated the internal SearXNG credential in .env"
  fi

  local app_key
  app_key="$(env_value APP_KEY || true)"
  if [[ ! "$app_key" =~ ^base64:[A-Za-z0-9+/]{43}=$ ]]; then
    set_env_value .env APP_KEY "base64:$(random_base64_32)"
    echo "Generated the Laravel application key in .env"
  fi
  chmod 600 .env
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is required for 'talos up'. Install Docker or run 'talos dev'." >&2
    return 1
  fi
  if ! compose version >/dev/null 2>&1; then
    echo "The Docker Compose plugin is required for 'talos up'." >&2
    return 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "The Docker daemon is not reachable. Start Docker and retry." >&2
    return 1
  fi
}

native_bootstrap() {
  local mode="${1:-install}"
  local args=()
  if [ "$mode" = "repair" ]; then
    args+=(--repair)
  fi
  bash "$ROOT_DIR/scripts/bootstrap-tools.sh" "${args[@]}"
}

acquire_native_setup_lock() {
  local lock_dir="$ROOT_DIR/.tools/.native-setup.lock"
  local owner_file="$lock_dir/owner"
  mkdir -p "$ROOT_DIR/.tools"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    local owner=""
    if [ -f "$owner_file" ]; then
      owner="$(cat "$owner_file" 2>/dev/null || true)"
    fi
    if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
      echo "Another TALOS native setup/dev process is active (PID $owner)." >&2
      return 1
    fi
    rm -f "$owner_file"
    rmdir "$lock_dir" 2>/dev/null || {
      echo "The native setup lock is stale but cannot be cleared: $lock_dir" >&2
      return 1
    }
    mkdir "$lock_dir"
  fi
  printf '%s\n' "$$" > "$owner_file"
  trap 'rm -f "$ROOT_DIR/.tools/.native-setup.lock/owner"; rmdir "$ROOT_DIR/.tools/.native-setup.lock" 2>/dev/null || true' EXIT INT TERM
}

dependency_needs_install() {
  local lock_file="$1"
  local required_file="$2"
  local marker="$3"
  [ ! -f "$required_file" ] || [ ! -f "$marker" ] || [ "$lock_file" -nt "$marker" ]
}

ensure_native_dependencies() {
  local composer="$ROOT_DIR/.tools/bin/composer.cmd"
  local npm="$ROOT_DIR/.tools/bin/npm.cmd"
  local markers="$ROOT_DIR/.tools/state/dependencies"
  mkdir -p "$markers"

  if dependency_needs_install "$ROOT_DIR/core/composer.lock" "$ROOT_DIR/core/vendor/autoload.php" "$markers/core-composer"; then
    print_step "Installing locked KADMOS dependencies"
    (cd "$ROOT_DIR/core" && "$composer" install --no-interaction --prefer-dist)
    touch "$markers/core-composer"
  fi
  if dependency_needs_install "$ROOT_DIR/control-plane/composer.lock" "$ROOT_DIR/control-plane/vendor/autoload.php" "$markers/control-plane-composer"; then
    print_step "Installing locked control-plane dependencies"
    (cd "$ROOT_DIR/control-plane" && "$composer" install --no-interaction --prefer-dist)
    touch "$markers/control-plane-composer"
  fi

  local package
  for package in validator browser-worker control-plane; do
    if dependency_needs_install "$ROOT_DIR/$package/package-lock.json" "$ROOT_DIR/$package/node_modules/.package-lock.json" "$markers/$package-npm"; then
      print_step "Installing locked $package dependencies"
      "$npm" --prefix "$ROOT_DIR/$package" ci
      touch "$markers/$package-npm"
    fi
  done

  if ! "$npm" --prefix "$ROOT_DIR/browser-worker" run doctor:runtime >/dev/null 2>&1; then
    print_step "Installing the pinned Chromium browser runtime"
    "$npm" --prefix "$ROOT_DIR/browser-worker" exec playwright install chromium
  fi
  "$npm" --prefix "$ROOT_DIR/browser-worker" run doctor:runtime >/dev/null
  touch "$markers/browser-worker-playwright"
}

ensure_native_application() {
  local php="$ROOT_DIR/.tools/bin/php.cmd"
  local env_file="$ROOT_DIR/control-plane/.env"
  if [ ! -f "$env_file" ]; then
    cp "$ROOT_DIR/control-plane/.env.example" "$env_file"
    echo "Created control-plane/.env from its template"
  fi
  mkdir -p "$ROOT_DIR/control-plane/database"
  touch "$ROOT_DIR/control-plane/database/database.sqlite"
  if ! grep -Eq '^APP_KEY=base64:.+' "$env_file"; then
    (cd "$ROOT_DIR/control-plane" && "$php" artisan key:generate --force)
  fi
  (cd "$ROOT_DIR/control-plane" && "$php" artisan migrate --force && "$php" artisan config:clear)
}

native_setup() {
  local mode="${1:-install}"
  acquire_native_setup_lock
  native_bootstrap "$mode"
  ensure_native_dependencies
  ensure_native_application
}

talos_url() {
  local app_url
  app_url="$(env_value APP_URL)"
  if [ -n "$app_url" ]; then
    printf '%s\n' "$app_url"
    return
  fi

  local port
  port="$(env_value APP_PORT)"
  printf 'http://localhost:%s\n' "${port:-8088}"
}

active_talos_url() {
  local native_url="http://127.0.0.1:8000"
  if command -v curl >/dev/null 2>&1 && curl -fsS "${native_url}/readyz" >/dev/null 2>&1; then
    printf '%s\n' "$native_url"
    return
  fi
  talos_url
}

open_url() {
  local url="$1"
  if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -Command "Start-Process '$url'" >/dev/null 2>&1 || true
  elif command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  else
    echo "Open $url"
  fi
}

wait_for_ready() {
  local url
  url="$(talos_url)"
  local ready_url="${url%/}/readyz"

  local attempt
  for attempt in $(seq 1 30); do
    if command -v curl >/dev/null 2>&1 && curl -fsS "$ready_url" >/dev/null 2>&1; then
      echo "Readiness OK: $ready_url"
      return 0
    fi
    if ! command -v curl >/dev/null 2>&1 \
      && compose exec -T talos php -r \
        "exit(@file_get_contents('http://127.0.0.1:8088/readyz') === false ? 1 : 0);" >/dev/null 2>&1; then
      echo "Readiness OK: $ready_url"
      return 0
    fi
    sleep 2
  done

  echo "Readiness failed: $ready_url" >&2
  compose ps || true
  compose logs --tail=120 talos validator browser-worker || true
  echo "Run: ./talos doctor" >&2
  return 1
}

wait_for_search_ready() {
  local search_health_url="http://127.0.0.1:8080/healthz"
  local search_json_url="http://127.0.0.1:8080/search?q=talos&format=json"

  local attempt
  for attempt in $(seq 1 15); do
    if compose exec -T searxng wget --spider --quiet --timeout=5 --tries=1 "$search_health_url" >/dev/null 2>&1; then
      echo "SearXNG liveness OK: $search_health_url"
      break
    fi
    sleep 2
  done

  if ! compose exec -T searxng wget --spider --quiet --timeout=5 --tries=1 "$search_health_url" >/dev/null 2>&1; then
    echo "SearXNG readiness failed: $search_health_url" >&2
    compose ps searxng || true
    compose logs --tail=120 searxng || true
    echo "Check the SearXNG container and run: ./talos doctor" >&2
    return 1
  fi

  local probe_error=""
  for attempt in $(seq 1 3); do
    if probe_error="$(compose exec -T searxng python3 -c \
      "import json,urllib.request; payload=json.load(urllib.request.urlopen('${search_json_url}', timeout=5)); raise SystemExit(0 if isinstance(payload, dict) and isinstance(payload.get('results'), list) else 1)" 2>&1)"; then
      echo "SearXNG JSON readiness OK: $search_json_url (results list shape valid; results may be empty)"
      return 0
    fi
    sleep 2
  done

  echo "SearXNG JSON readiness failed: $search_json_url" >&2
  if [ -n "$probe_error" ]; then
    echo "Last JSON probe error: $probe_error" >&2
  fi
  compose ps searxng || true
  compose logs --tail=120 searxng || true
  echo "Check the SearXNG JSON API and run: ./talos doctor" >&2
  return 1
}

browser_worker_ownership_doctor() {
  local node_bin=""
  if [ -x "$ROOT_DIR/.tools/bin/node" ]; then
    node_bin="$ROOT_DIR/.tools/bin/node"
  elif [ -f "$ROOT_DIR/.tools/bin/node.cmd" ]; then
    node_bin="$ROOT_DIR/.tools/bin/node.cmd"
  elif command -v node >/dev/null 2>&1; then
    node_bin="$(command -v node)"
  fi

  if [ -z "$node_bin" ]; then
    echo "browser ownership   WARN Node.js is unavailable; endpoint ownership was not inspected"
    return 0
  fi

  "$node_bin" "$ROOT_DIR/control-plane/scripts/browser-worker-ownership.mjs" --doctor
}

doctor() {
  local repair="${1:-}"
  local docker_available=0
  local compose_available=0
  local docker_ready=0
  local native_ready=0
  local browser_ownership_ready=0
  echo "TALOS Doctor"
  echo "------------"

  if command -v docker >/dev/null 2>&1; then
    echo "docker              OK   $(docker --version)"
    docker_available=1
  else
    echo "docker              WARN Docker CLI is not available"
  fi

  if [ "$docker_available" -eq 1 ] && compose version >/dev/null 2>&1; then
    echo "docker compose      OK   $(compose version)"
    compose_available=1
  else
    echo "docker compose      WARN Docker Compose plugin is not available"
  fi

  if [ -f .env ]; then
    echo ".env                OK   present"
  else
    echo ".env                WARN missing; talos up will create it"
  fi

  if [ -f docker-compose.yml ]; then
    echo "compose file        OK   docker-compose.yml"
  else
    echo "compose file        FAIL docker-compose.yml missing"
  fi

  if [ "$docker_available" -eq 1 ] && [ "$compose_available" -eq 1 ]; then
    if ! docker info >/dev/null 2>&1; then
      echo "docker daemon       WARN unavailable"
    elif compose config >/dev/null 2>&1; then
      echo "docker daemon       OK   reachable"
      echo "compose config      OK   valid"
      docker_ready=1
    else
      echo "compose config      FAIL invalid"
    fi
  else
    echo "compose config      SKIP Docker Compose unavailable"
  fi

  if [ "$repair" = "--repair" ]; then
    print_step "Repairing native toolchain and application state"
    native_setup repair
    native_ready=1
  elif bash "$ROOT_DIR/scripts/bootstrap-tools.sh" --verify-only >/dev/null 2>&1; then
    native_ready=1
  fi

  if [ "$native_ready" -eq 1 ]; then
    echo "native toolchain    OK   pinned and relocatable"
    if [ -f "$ROOT_DIR/core/vendor/autoload.php" ] \
      && [ -f "$ROOT_DIR/control-plane/vendor/autoload.php" ] \
      && [ -f "$ROOT_DIR/validator/node_modules/.package-lock.json" ] \
      && [ -f "$ROOT_DIR/browser-worker/node_modules/.package-lock.json" ] \
      && [ -f "$ROOT_DIR/control-plane/node_modules/.package-lock.json" ]; then
      if "$ROOT_DIR/.tools/bin/npm.cmd" --prefix "$ROOT_DIR/browser-worker" run doctor:runtime >/dev/null 2>&1; then
        echo "native dependencies OK   installed"
        echo "browser runtime     OK   Chromium executable is installed"
      else
        echo "browser runtime     WARN run ./talos doctor --repair"
        native_ready=0
      fi
    else
      echo "native dependencies WARN run ./talos dev or ./talos doctor --repair"
      native_ready=0
    fi
  else
    echo "native toolchain    WARN run ./talos dev or ./talos doctor --repair"
  fi

  if browser_worker_ownership_doctor; then
    browser_ownership_ready=1
  fi

  if [ "$docker_available" -eq 1 ] && [ "$compose_available" -eq 1 ] && compose ps >/dev/null 2>&1; then
    compose ps
  fi

  local url
  url="$(talos_url)"
  if command -v curl >/dev/null 2>&1; then
    if curl -fsS "${url%/}/readyz" >/dev/null 2>&1; then
      echo "docker readyz       OK   ${url%/}/readyz"
    else
      echo "docker readyz       WARN ${url%/}/readyz is not healthy or not running"
    fi
    if curl -fsS "http://127.0.0.1:8000/readyz" >/dev/null 2>&1; then
      echo "native readyz       OK   http://127.0.0.1:8000/readyz"
    else
      echo "native readyz       WARN http://127.0.0.1:8000/readyz is not healthy or not running"
    fi
  fi

  if { [ "$docker_ready" -eq 1 ] || [ "$native_ready" -eq 1 ]; } \
    && [ "$browser_ownership_ready" -eq 1 ]; then
    return 0
  fi
  return 1
}

args=()
for arg in "$@"; do
  case "$arg" in
    --no-boot|--plain)
      BOOT_DISABLED=1
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

set -- "${args[@]}"
cmd="${1:-help}"
maybe_boot "$cmd"

case "$cmd" in
  up)
    require_docker
    print_step "Preparing environment"
    ensure_env
    reconcile_stale_search_service
    print_step "Building and starting TALOS, queue, validator, and browser worker"
    compose up -d --build
    print_step "Checking readiness"
    wait_for_ready
    if [ "$(effective_env_value TALOS_WEB_SEARCH_PROVIDER)" = "searxng" ]; then
      wait_for_search_ready
    fi
    echo "TALOS is starting at $(talos_url)"
    ;;
  dev)
    print_step "Preparing the native development workspace"
    native_setup
    print_step "Starting TALOS at http://127.0.0.1:8000"
    (cd "$ROOT_DIR/control-plane" && "$ROOT_DIR/.tools/bin/composer.cmd" run dev)
    ;;
  down)
    print_step "Stopping TALOS stack"
    compose_all_profiles down
    ;;
  logs)
    compose logs -f
    ;;
  doctor)
    doctor "${2:-}"
    ;;
  open)
    print_step "Opening TALOS workspace"
    open_url "$(active_talos_url)"
    ;;
  fresh)
    require_docker
    echo "This removes local TALOS Docker volumes. Use only for development."
    read -r -p "Type RESET to continue: " confirm
    if [ "$confirm" != "RESET" ]; then
      echo "Aborted."
      exit 1
    fi
    print_step "Resetting Docker volumes"
    compose_all_profiles down -v
    print_step "Preparing environment"
    ensure_env
    print_step "Building and starting fresh TALOS stack"
    compose up -d --build
    print_step "Checking readiness"
    wait_for_ready
    if [ "$(effective_env_value TALOS_WEB_SEARCH_PROVIDER)" = "searxng" ]; then
      wait_for_search_ready
    fi
    echo "Fresh TALOS stack is starting at $(talos_url)"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
