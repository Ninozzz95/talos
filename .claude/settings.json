{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\Antonino\\.local\\bin\\rtk.exe hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/non-fermarti.mjs\"",
            "timeout": 10,
            "statusMessage": "Controllo che la fermata serva davvero..."
          }
        ]
      }
    ]
  }
}
