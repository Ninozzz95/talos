   # ⇒ Un test che non gira non è un test: è un file. E il motivo per cui il
   # difetto è potuto restare lì per settimane è ESATTAMENTE l'assenza di questo
   # lavoro.
+  # ⛔⛔⛔ 07/9 — IL DESKTOP NON ESISTEVA PER LA CI. Questo file provava la app mobile e la
+  # compilava per Android; `harness-ui/` — il prodotto desktop, il suo server, il suo frontend e il
+  # kernel — non compariva in nessuna riga (misurato: zero occorrenze di «harness-ui» in ci.yml e
+  # release.yml). Un cancello che non guarda un prodotto non lo protegge: ogni rosso del desktop si
+  # scopriva a mano, sulla macchina di chi lo stava scrivendo.
+  #
+  # ⛔ Gira SOLO dove il desktop esiste. Nel repo pubblicato del mobile `harness-ui/` non c'è, e un
+  # job che fallisse per una cartella assente sarebbe rumore, non un cancello: il primo passo lo
+  # dichiara e gli altri se ne vanno se non c'è.
+  #
+  # I quattro cancelli, gli stessi che si lanciano a mano:
+  #   server + kernel + impronta del kernel   npm run verify:all (parte 1)
+  #   unit del frontend                       npm --prefix frontend run test:unit
+  #   parità dei componenti e lab             i due file di configurazione Playwright
+  desktop:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+
+      - id: dove
+        name: c'e il desktop in questo repo?
+        run: |
+          if [ -f harness-ui/package.json ]; then
+            echo "ci=si" >> "$GITHUB_OUTPUT"
+            echo "harness-ui c'e: i cancelli del desktop girano"
+          else
+            echo "ci=no" >> "$GITHUB_OUTPUT"
+            echo "harness-ui non c'e in questo repo (disposizione mobile): niente da provare"
+          fi
+
+      - if: steps.dove.outputs.ci == 'si'
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
+        with:
+          node-version: 24
+          cache: npm
+          cache-dependency-path: harness-ui/package-lock.json
+
+      # ⛔ `node-pty` si compila all'installazione: senza gli strumenti nativi `npm ci` muore con un
+      #    errore che parla di gyp e non del nostro codice.
+      - if: steps.dove.outputs.ci == 'si'
+        name: dipendenze del server
+        run: npm ci --ignore-scripts
+        working-directory: harness-ui
+
+      - if: steps.dove.outputs.ci == 'si'
+        name: dipendenze del frontend
+        run: npm ci
+        working-directory: harness-ui/frontend
+
+      - if: steps.dove.outputs.ci == 'si'
+        name: server
+        run: node --test tests/*.test.mjs
+        working-directory: harness-ui
+
+      # ⛔ Il kernel ha la sua suite (538 prove) e fino al 07/9 in questo repo non la lanciava
+      #    nessuno. Il suo cancello semantico legge `lib.*.d.ts` da node_modules/typescript: se un
+      #    giorno quella dipendenza sparisce, qui si vedono due rossi, non un silenzio.
+      - if: steps.dove.outputs.ci == 'si'
+        name: kernel
+        run: npm run test:kernel
+        working-directory: harness-ui
+
+      - if: steps.dove.outputs.ci == 'si'
+        name: il kernel del repo e quello della fonte
+        run: npm run kernel:controlla
+        working-directory: harness-ui
+
+      - if: steps.dove.outputs.ci == 'si'
+        name: unit del frontend
+        run: npm run test:unit
+        working-directory: harness-ui/frontend
+
+      - if: steps.dove.outputs.ci == 'si'
+        name: il browser
+        run: npx playwright install --with-deps chromium
+        working-directory: harness-ui/frontend
+
+      - if: steps.dove.outputs.ci == 'si'
+        name: build del frontend
+        run: npm run build
+        working-directory: harness-ui/frontend
+
+      - if: steps.dove.outputs.ci == 'si'
+        name: parita dei componenti col mockup
+        run: npx playwright test -c playwright.componenti.config.mjs --reporter=line
+        working-directory: harness-ui/frontend
+
+      - if: steps.dove.outputs.ci == 'si'
+        name: lab dei componenti
+        run: npx playwright test -c playwright.lab.config.mjs --reporter=line
+        working-directory: harness-ui/frontend
+
+      - if: failure() && steps.dove.outputs.ci == 'si'
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: desktop-resti
+          path: harness-ui/frontend/test-results/
+          retention-days: 7
+
